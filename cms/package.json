    "./schemaTypes/index.js": "./schemaTypes/index.js",
    "./schemaTypes/*": "./schemaTypes/*",
    "./components/ProductMenuSelect.jsx": "./components/ProductMenuSelect.jsx",
    "./components/*": "./components/*"
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
