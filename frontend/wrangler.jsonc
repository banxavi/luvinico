// Canonical Wrangler config when working in frontend/. Repo-root CI uses ../wrangler.jsonc (paths prefixed with frontend/).
{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "main": ".open-next/worker.js",
    "name": "luvinico",
    // Set this to today's date
    "compatibility_date": "2026-07-11",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "services": [
        {
            // Required for ISR/revalidation; service name must match worker `name` above
            // https://opennext.js.org/cloudflare/caching
            "binding": "WORKER_SELF_REFERENCE",
            "service": "luvinico"
        }
    ],
    "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true
        }
    },
    "vars": {
        // Set NEXT_PUBLIC_SITE_URL (+ secrets) in Cloudflare Dashboard.
        // SANITY_STUDIO_ORIGIN: proxy /admin → hosted Studio (works on workers.dev).
        // Do NOT set SANITY_STUDIO_DEV_ORIGIN on Cloudflare (local iframe only).
        "NEXT_PUBLIC_SANITY_PROJECT_ID": "sfqhf74q",
        "NEXT_PUBLIC_SANITY_DATASET": "production",
        "SANITY_STUDIO_ORIGIN": "https://luvini.sanity.studio"
    }
}