    "embla-carousel-fade": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "marked": "^18.0.5",
    "next": "16.2.11",
    "next-sanity": "^13.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sanity": "^6.6.0",
    "styled-components": "^6.4.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "19.2.14",
