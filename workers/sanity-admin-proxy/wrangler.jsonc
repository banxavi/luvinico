{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luvinico-sanity-admin-proxy",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-11",
  // Origin Sanity hosted Studio (no trailing slash). Example: https://luvinico.sanity.studio
  "vars": {
    "STUDIO_ORIGIN": "https://YOUR-STUDIO-HOST.sanity.studio"
  }
  // Route: attach in Dashboard (recommended) or uncomment and set your zone:
  // "routes": [
  //   { "pattern": "example.com/admin*", "zone_name": "example.com" },
  //   { "pattern": "www.example.com/admin*", "zone_name": "example.com" }
  // ]
}
